# Local Terraform directories
**/.terraform/
**/.terraform.*/

# .tfstate files
*.tfstate
*.tfstate.*
*.tfstate.backup

# Crash log files
crash.log
crash.*.log
terraform.tf.state.lock.info

# Exclude all .tfstate files and .tfstate backup files
*.tfstate
*.tfstate.backup

# Ignore archive files
*.tar.gz
*.zip

# .tfvars files
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used to override resources which are
# managed by cloud, etc.
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include override files you do wish to add to version control using negated pattern
# !example_override.tf

# Lock file
.terraform.lock.hcl

# CLI configuration files
.terraformrc
terraform.rc

# Plan output
*.plan
*.tfplan
tfplan

# Core files
*.core

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-*

# OS-specific files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Log files
*.log
logs/

# Temporary files
*.tmp
*.temp
tmp/
temp/

# Backup files
*.bak
*.backup

# Kubernetes files
kubeconfig
kubeconfig_*
*.kubeconfig
.kube/

# AWS CLI and credentials (should never be in version control)
.aws/
*.pem
*.key
*.cert
*.crt
*.p12

# Environment files with secrets
.env
*.env
.secret
.secrets

# SSH keys
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub

# Terragrunt cache
.terragrunt-cache/
terragrunt.hcl

# Build artifacts
build/
dist/
pkg/

# Package files
*.tar.gz
*.zip

# Documentation
*.terraform.docs.yml

# Test and example directories
examples/
test/
tests/

# YAML lint configuration
.yamllint

# Makefile artifacts (if any specific to your project)
*.done
*.built

# Helm charts (if using helm provider)
charts/
*.tgz

# Local override files for development
local.tf
local_*.tf

# Uncommitted files that might be generated during development
.cache/
.output/

# Git related (in case someone ignores the root .git)
.git/

# CI/CD configuration (keep only the one you use)
.jenkins/
.gitlab-ci.yml
.circleci/
.travis.yml
.github/workflows/*.backup

# Python virtual environment (if using Python scripts)
venv/
.env/
.venv/
ENV/

# Node.js (if using Node.js scripts)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.lock-wscript

# Go (if using Go scripts)
bin/
/pkg/

# Ruby (if using Ruby scripts)
/.bundle/
/vendor/bundle

# Compiled files
*.so
*.dylib
*.a
*.o
*.obj

# Executables
*.exe
*.out
*.app

# Specific to your project structure
output/
artifacts/
downloads/

# Local development overrides
.devcontainer/
aws/install
aws/THIRD_PARTY_LICENSES
